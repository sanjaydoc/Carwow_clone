# Copy to `.env` and edit. All paths are local to your laptop.

# Path to your cloned De-Novo-LLM repo (needed for Track B molecule generation).
# Track A (construct assembly) and epigenetic age work without it.
DENOVO_LLM_DIR=../../De-Novo-LLM

# Python interpreter of the De-Novo-LLM venv (so we call its `denovo` CLI).
# Leave blank to use `denovo` from PATH / the current environment.
DENOVO_PYTHON=

# "laptop" keeps generations small and serializes GPU jobs (6 GB VRAM friendly).
# "full" removes the caps (use only with more VRAM).
SIM_MODE=laptop

# Where uploads, jobs and outputs are written (kept on-device).
SIM_WORK_DIR=./_work

# Comma-separated origins allowed to call the API. For a purely local UI served
# by this backend you don't need to change this.
SIM_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
